programa {
  funcao inicio() {
    inteiro opcao = 1

    //inicio da estrutura
    escolha (opcao){
      caso 1:
      escreva("Novo jogo")
      pare

      caso 2:
      escreva("Carregar jogo")
      pare

      caso 3:
      escreva("Sair")
      pare

      caso contrario:
      escreva("Opção Inválida")
      pare

    }
  }
}
