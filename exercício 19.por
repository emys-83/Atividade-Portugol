programa {
  funcao inicio() {
    //1 - Declarar a variavel 
    inteiro idade 

    //2 - Entrada de dados 
    escreva("Qual a sua idade? ")
    leia(idade)

    //3 - Estrutura de decisão 
    se(idade >= 18){
      escreva("Você é maior de idade")
    }
    senao {
      escreva("Você é menor de idade")
    }
  }
}
