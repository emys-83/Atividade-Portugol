programa {
  funcao inicio() {
    //Nome do algoritmo : Receita 

    escreva("Passo 1 - Pegue duas fatias de pão \n")
    escreva("Passo 2 - Passe a manteiga nas fatias \n")
    escreva("Passo 3 - Coloque uma fatia de queijo sobre o pão \n")
    escreva("Passo 4 - Adicione uma fatia de presunto \n")
    escreva("Passo 5 - Coloque a outra fatia do pão por cima \n")
    escreva("Passo 6 - O seu sanduíche está pronto! \n")
  }
}
