programa {
  funcao inicio() {
    //Completar o código
    real nota = 6.5

    //Condição para aprovação
    se (nota >= 7){
      escreva("Aprovado")
    }

    //Condição para recuperação
    senao se (nota >= 5){
      escreva("Recuperação")
    }

    //Caso não atenda nenhuma das anteriores
    senao {
      escreva("Reprovado")
    }
  }
}
