programa {
  funcao inicio() {
    
    real numero1
    real numero2
    real resultado

    escreva("Digite o primeiro número: ")
    leia(numero1)

    escreva("Digite o segundo número: ")
    leia(numero2)

    resultado = numero1 + numero2

    escreva("A soma de ", numero1, " com ", numero2, " é igual a: ", resultado)

  }
}
