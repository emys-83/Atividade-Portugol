programa {
  funcao inicio() {
    //Cinco tipos primitivos

    inteiro idade = 20
    real altura = 1.75
    cadeia nome = "Maria"
    caracter inicial = 'M'
    logico estuda = verdadeiro

    escreva("Idade: ", idade, "\n")
    escreva("Altura: ", altura, "\n")
    escreva("Nome: ", nome, "\n")
    escreva("Inicial: ", inicial, "\n")
    escreva("Estuda: ", verdadeiro, "\n")
  }
}