programa {
  funcao inicio() {

    inteiro A = 10
    inteiro B = 3
    inteiro resultadoDivisao
    inteiro restoDivisao

    resultadoDivisao = A / B 
    restoDivisao = A % B 

    escreva("O valor de A: ", A, "\n")
    escreva("O valor de B: ", B, "\n")
    escreva("----------------------\n")
    escreva("Resultado da divisão (A / B): ", resultadoDivisao, "\n")
    escreva("Resto da divisão (A % B): ", restoDivisao, "\n")
  }
}
